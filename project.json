{
  "format": "asternal-game",
  "version": 1,
  "name": "Asternal 2D Game",
  "engine": { "id": "asternal-engine", "version": "0.1.0", "renderer": "canvas2d" },
  "mainScene": "scenes/main.scene.json",
  "editor": { "defaultView": "scene", "grid": "native", "defaultLanguage": "es" },
  "input": {
    "move_left": ["ArrowLeft", "KeyA"],
    "move_right": ["ArrowRight", "KeyD"],
